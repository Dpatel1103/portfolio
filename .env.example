# =============================================================================
# OWL POST BACKEND ENVIRONMENT CONFIGURATION
# Copy this file to .env and configure your secrets
# =============================================================================

# Server Port (Default: 3000)
PORT=3000

# Node Environment ('development' or 'production')
NODE_ENV=production

# Allowed Frontend Origins for CORS (Comma-separated for multiple origins)
# Example: https://dpatel1103.github.io,http://localhost:5500
ALLOWED_ORIGIN=https://dpatel1103.github.io

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION (PostgreSQL / Supabase)
# Option A: Direct PostgreSQL URI (Supabase Project Settings -> Database -> Connection URI)
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
#
# Option B: Supabase REST API (Project Settings -> API)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# -----------------------------------------------------------------------------
# RESEND EMAIL SERVICE CONFIGURATION (https://resend.com/api-keys)
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key_here

# Recipient Email for Owl Post Notifications
NOTIFICATION_EMAIL=devanshi1303@gmail.com

# Sender Email Address (Use onboarding@resend.dev for test, or your verified domain)
RESEND_FROM_EMAIL=Owl Post <onboarding@resend.dev>

# -----------------------------------------------------------------------------
# OPTIONAL: ADMIN ACCESS TOKEN
# Passphrase for viewing received scrolls at GET /api/owl-post/messages
# -----------------------------------------------------------------------------
ADMIN_SECRET_TOKEN=choose-a-strong-secret-passphrase
